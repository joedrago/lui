{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "esnext",
        "lib": ["esnext"],
        "types": ["node"],
        "typeRoots": ["./node_modules/@types"],
        "strict": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "maxNodeModuleJsDepth": 0
    },
    "include": ["src/**/*.js", "bin/**/*"],
    "exclude": ["node_modules", "old", "**/node_modules/**", "../node_modules", "../../node_modules"]
}
