{
    "name": "lui",
    "version": "0.2.0",
    "description": "A friendly TUI wrapper for llama.cpp's llama-server (and other engines)",
    "type": "module",
    "bin": {
        "lui": "bin/lui"
    },
    "scripts": {
        "format": "prettier --write .",
        "lint": "eslint ."
    },
    "dependencies": {
        "jsonc-parser": "^3.3.1",
        "smol-toml": "^1.3.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.18.0",
        "eslint": "^9.18.0",
        "globals": "^15.14.0",
        "prettier": "^3.4.2"
    },
    "prettier": {
        "printWidth": 130,
        "tabWidth": 4,
        "trailingComma": "none",
        "semi": false
    },
    "engines": {
        "node": ">=20"
    }
}
